# --- Signing keys: NEVER upload these ---
*.jks
*.keystore
keystore.properties
signing/

# --- Built apps: attach these to a GitHub Release instead ---
*.apk
*.aab
android/app/release/

# --- Dependencies and build output (recreated by npm install / Gradle) ---
node_modules/
