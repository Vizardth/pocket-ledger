android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml

# --- Personal data exports: keep them out of the repo ---
pocket-ledger-backup-*.json
pocket-ledger-*.csv
pocket-ledger-report-*.md

# --- System files ---
.DS_Store
Thumbs.db
